# ==============================================================================
# Enterprise Intelligence Platform - Environment Configuration Example
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Enterprise Intelligence Platform"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development" # development | test | production
DEBUG=false

# Security & Authentication (Generate secure secret for production: openssl rand -hex 32)
SECRET_KEY="generate-a-secure-random-secret-key-for-production-use"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with pgvector for production; SQLite for local testing)
# Production: postgresql+psycopg2://postgres:postgres@localhost:5432/engineering_intelligence
# Local Testing: sqlite:///./engineering_intelligence.db
DATABASE_URL="sqlite:///./engineering_intelligence.db"

# Storage Settings
STORAGE_DIR="storage/documents"
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB

# Primary LLM Provider (Anthropic Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=""
PRIMARY_LLM_PROVIDER="anthropic"
PRIMARY_LLM_MODEL="claude-3-5-sonnet-20241022"

# Fallback LLM Provider (OpenAI GPT-4o)
OPENAI_API_KEY=""
FALLBACK_LLM_PROVIDER="openai"
FALLBACK_LLM_MODEL="gpt-4o"

# Embedding Provider (OpenAI text-embedding-3-small)
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# Offline / Testing Fallbacks (Set to true to run offline without paid API keys)
USE_FAKE_LLM=false
USE_FAKE_EMBEDDINGS=false

# Retrieval & RAG Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5
RRF_K=60
SIMILARITY_THRESHOLD=0.25

# Autonomous Agent Limits
AGENT_MAX_STEPS=5
AGENT_TIMEOUT_SECONDS=30

# CORS Allowed Origins
CORS_ORIGINS=["*"]

