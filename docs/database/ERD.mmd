erDiagram
    %% =========================================================================
    %% ACTIVE DATABASE ENTITY RELATIONSHIP DIAGRAM (ERD)
    %% Engineering Intelligence Platform — 11 Active Tables
    %% =========================================================================

    USERS ||--o{ WORKSPACES : "owns"
    USERS ||--o{ WORKSPACE_MEMBERS : "member_of"
    USERS ||--o{ DOCUMENTS : "creates"
    USERS ||--o{ CONVERSATIONS : "initiates"
    USERS ||--o{ AGENT_RUNS : "triggers"
    USERS ||--o{ LLM_LOGS : "accrues_usage"

    WORKSPACES ||--o{ WORKSPACE_MEMBERS : "contains"
    WORKSPACES ||--o{ DOCUMENTS : "isolates"
    WORKSPACES ||--o{ CHUNKS : "scopes"
    WORKSPACES ||--o{ CONVERSATIONS : "houses"
    WORKSPACES ||--o{ AGENT_RUNS : "executes"
    WORKSPACES ||--o{ LLM_LOGS : "bills_to"

    DOCUMENTS ||--o{ CHUNKS : "chunked_into"
    DOCUMENTS ||--o{ CITATIONS : "referenced_in"

    CONVERSATIONS ||--o{ MESSAGES : "contains"
    CONVERSATIONS ||--o{ AGENT_RUNS : "links_to"

    MESSAGES ||--o{ CITATIONS : "cites"
    CHUNKS ||--o{ CITATIONS : "evidence_for"

    AGENT_RUNS ||--o{ AGENT_TOOL_EXECUTIONS : "executes_steps"

    %% =========================================================================
    %% ENTITY DEFINITIONS & SCHEMAS
    %% =========================================================================

    USERS {
        string id PK "UUID (String 36)"
        string email UK "Unique Email (String 255)"
        string hashed_password "Bcrypt Hash (String 255)"
        string full_name "Full Name (String 255)"
        string role "admin | engineer | viewer (String 50)"
        boolean is_active "Active Account Status"
        datetime created_at "Creation Timestamp"
        datetime updated_at "Update Timestamp"
    }

    WORKSPACES {
        string id PK "UUID (String 36)"
        string name "Workspace Name (String 255)"
        string slug UK "Unique Slug (String 255)"
        string description "Optional Workspace Description"
        string owner_id FK "References users.id ON DELETE CASCADE"
        datetime created_at "Creation Timestamp"
        datetime updated_at "Update Timestamp"
    }

    WORKSPACE_MEMBERS {
        string id PK "UUID (String 36)"
        string workspace_id FK "References workspaces.id ON DELETE CASCADE"
        string user_id FK "References users.id ON DELETE CASCADE"
        string role "admin | member | viewer (String 50)"
        datetime created_at "Join Timestamp"
    }

    DOCUMENTS {
        string id PK "UUID (String 36)"
        string workspace_id FK "References workspaces.id ON DELETE CASCADE"
        string title "Document Title (String 255)"
        string filename "Original File Name (String 255)"
        string file_path "Stored Disk Path (String 512)"
        integer file_size_bytes "File Size in Bytes"
        string file_type "pdf | txt | md | csv (String 50)"
        string file_hash "SHA-256 Checksum (String 64)"
        string status "PENDING | PROCESSING | INDEXED | FAILED"
        integer chunk_count "Total Chunks Extracted"
        text error_message "Ingestion Error If Failed"
        json doc_metadata "Document JSON Metadata"
        string created_by FK "References users.id ON DELETE SET NULL"
        datetime created_at "Creation Timestamp"
        datetime updated_at "Update Timestamp"
    }

    CHUNKS {
        string id PK "UUID (String 36)"
        string document_id FK "References documents.id ON DELETE CASCADE"
        string workspace_id FK "References workspaces.id ON DELETE CASCADE"
        integer chunk_index "Sequential Chunk Index"
        text content "Chunk Text Payload"
        json chunk_metadata "Token Count, Source Page/Heading"
        vector embedding "1536-dimensional Vector (pgvector)"
        datetime created_at "Creation Timestamp"
    }

    CONVERSATIONS {
        string id PK "UUID (String 36)"
        string workspace_id FK "References workspaces.id ON DELETE CASCADE"
        string user_id FK "References users.id ON DELETE CASCADE"
        string title "Conversation Title (String 255)"
        text summary "Conversational Sliding Summary"
        json conv_metadata "Metadata / Config Options"
        datetime created_at "Creation Timestamp"
        datetime updated_at "Update Timestamp"
    }

    MESSAGES {
        string id PK "UUID (String 36)"
        string conversation_id FK "References conversations.id ON DELETE CASCADE"
        string role "user | assistant | system (String 50)"
        text content "Message Content Markdown"
        integer token_count "Estimated Token Count"
        json msg_metadata "Citations & Model Info JSON"
        datetime created_at "Creation Timestamp"
    }

    CITATIONS {
        string id PK "UUID (String 36)"
        string message_id FK "References messages.id ON DELETE CASCADE"
        string chunk_id FK "References chunks.id ON DELETE CASCADE"
        string document_id "Referenced Document UUID (String 36)"
        string citation_marker "Marker e.g. [c_0], [c_1] (String 20)"
        float score "Relevance / Similarity Score"
        text snippet "Verbatim Snippet Excerpt"
        datetime created_at "Creation Timestamp"
    }

    AGENT_RUNS {
        string id PK "UUID (String 36)"
        string workspace_id FK "References workspaces.id ON DELETE CASCADE"
        string user_id FK "References users.id ON DELETE CASCADE"
        string conversation_id FK "References conversations.id ON DELETE SET NULL"
        text task "User Investigation Prompt"
        string status "running | completed | failed (String 50)"
        json plan "Multi-Step Execution Plan"
        text final_output "Final Markdown Report"
        integer total_steps "Total Tool Steps Taken"
        integer execution_time_ms "Total Execution Duration"
        datetime created_at "Start Timestamp"
        datetime completed_at "End Timestamp"
    }

    AGENT_TOOL_EXECUTIONS {
        string id PK "UUID (String 36)"
        string agent_run_id FK "References agent_runs.id ON DELETE CASCADE"
        integer step_number "Step Sequence Number"
        string tool_name "Tool Identifier (String 100)"
        json tool_input "Validated Tool Parameters JSON"
        json tool_output "Structured Output JSON"
        string status "success | failure (String 50)"
        integer execution_time_ms "Step Duration in Milliseconds"
        text error_message "Failure Message If Failed"
        datetime created_at "Step Timestamp"
    }

    LLM_LOGS {
        string id PK "UUID (String 36)"
        string workspace_id "Tenant Workspace UUID (String 36)"
        string user_id "User UUID (String 36)"
        string session_id "Conversation Session UUID (String 36)"
        string provider "anthropic | openai | fake (String 50)"
        string model "claude-3-5-sonnet | gpt-4o (String 100)"
        integer prompt_tokens "Input Token Count"
        integer completion_tokens "Generated Output Token Count"
        integer total_tokens "Total Billed Tokens"
        integer cached_prompt_tokens "Cached Prompt Token Count"
        integer latency_ms "Total Call Latency in Milliseconds"
        float cost_usd "Calculated Financial Cost in USD"
        boolean is_fallback "True If Secondary Fallback Provider Used"
        string status "success | error (String 50)"
        string error_type "Error Category (e.g. RateLimitError)"
        datetime created_at "Invocation Timestamp"
    }
