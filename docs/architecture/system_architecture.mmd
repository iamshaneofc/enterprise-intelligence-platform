flowchart TD
    %% =========================================================================
    %% SYSTEM ARCHITECTURE — ENGINEERING INTELLIGENCE PLATFORM (CURRENT WORKING)
    %% =========================================================================

    subgraph CLIENT_TIER ["Client Presentation Tier (Browser SPA - React 18 + Vite + TypeScript)"]
        UI_AUTH["Auth & Workspace Guard<br/>(JWT / Session State)"]
        UI_DOCS["Document Manager & Chunk Explorer<br/>(Upload Dropzone, Chunk Modal)"]
        UI_CHAT["Knowledge Chat & Citation Drawer<br/>(Grounded Markdown, Evidence Badges)"]
        UI_AGENT["Agent Studio & Step Timeline<br/>(Plan, Tool Runs, Final Output)"]
        UI_EVAL["Live Evaluation Dashboard<br/>(Aggregate Metrics & Category Breakdown)"]
        UI_SETTINGS["Settings & Telemetry Diagnostics<br/>(Usage Stats & System Health)"]
    end

    subgraph API_GATEWAY ["FastAPI ASGI Application Server (Port 8000)"]
        API_AUTH["/api/v1/auth<br/>(Register, Login, Me)"]
        API_WS["/api/v1/workspaces<br/>(CRUD, Scoping)"]
        API_DOCS["/api/v1/workspaces/{id}/documents<br/>(Upload, Chunks, Delete)"]
        API_CHAT["/api/v1/workspaces/{id}/chat<br/>(Grounded RAG & Citations)"]
        API_SEARCH["/api/v1/workspaces/{id}/search<br/>(Dense, Sparse, Hybrid)"]
        API_AGENT["/api/v1/workspaces/{id}/agent/investigate<br/>(Multi-Step Tool Loop)"]
        API_CONV["/api/v1/workspaces/{id}/conversations<br/>(History & Persistence)"]
        API_EVAL["/api/v1/workspaces/{id}/evaluation/run<br/>(Benchmark Execution)"]
        API_HEALTH["/health & /ready<br/>(System Diagnostics)"]
    end

    subgraph CORE_SERVICES ["Core Intelligence & Service Layer"]
        DOC_SVC["Document Ingestion Service<br/>(PyMuPDF, MD, CSV, TXT Parsers)"]
        CHUNK_SVC["Recursive Chunking & Tokenizer<br/>(Semantic Boundary Overlap)"]
        RAG_SVC["RAG Service Orchestrator<br/>(Context Assembly & Execution)"]
        GATE_SVC["Evidence Sufficiency Gate<br/>(Coverage Filter, Chunk Triage, Conflict Check)"]
        VERIFY_SVC["Claim Grounding Verifier<br/>(Token Overlap & Echo Stripping)"]
        HYBRID_SVC["Hybrid Retrieval Engine<br/>(Dense pgvector + BM25 FullText + RRF k=60)"]
        AGENT_SVC["Autonomous Agent Engine<br/>(Max 5 Steps, Loop Limits, Param Validation)"]
        MEM_SVC["Conversational Memory Manager<br/>(Sliding Window & Session Scoping)"]
        LLM_ROUTER["LLM Provider Fallback Router<br/>(Single-Entry Usage Accounting)"]
    end

    subgraph AGENT_TOOLS ["Controlled Agent Tools"]
        T1["Tool 1: Knowledge Base Search<br/>(Dense/Sparse Hybrid Query)"]
        T2["Tool 2: Document Analysis<br/>(Events, Symptoms, Causes)"]
        T3["Tool 3: Structured Report Generation<br/>(Findings, Evidence, Advice)"]
    end

    subgraph PERSISTENCE ["Persistence Tier (PostgreSQL 16 + pgvector / SQLite)"]
        DB_USERS[("users<br/>(Auth, Roles)")]
        DB_WORKSPACES[("workspaces & workspace_members<br/>(Tenant Scoping)")]
        DB_DOCS[("documents & chunks<br/>(Relational Meta + 1536d Vectors)")]
        DB_CONV[("conversations & messages<br/>(Thread History)")]
        DB_CITATIONS[("citations<br/>(Marker, Snippet, Score)")]
        DB_RUNS[("agent_runs & agent_tool_executions<br/>(Timeline Audit)")]
        DB_LOGS[("llm_logs<br/>(Tokens, Latency, Cost, Telemetry)")]
        LOCAL_STORAGE[("Local File Storage<br/>storage/documents/")]
    end

    subgraph OBSERVABILITY ["Observability & Tracing Tier"]
        LANGFUSE["Langfuse v5 Tracer<br/>(@observe Decorators, Fail-Safe Local/Cloud)"]
        DB_TELEMETRY["SQLAlchemy Usage Telemetry<br/>(LLMUsageEvent, Single-Entry Logging)"]
    end

    subgraph LLM_PROVIDERS ["LLM Provider Tier"]
        CLAUDE["Anthropic Claude 3.5 Sonnet<br/>(Primary Reasoning & Generation)"]
        OPENAI["OpenAI GPT-4o / text-embedding-3-small<br/>(Secondary Fallback & Vectors)"]
        FAKE_LLM["FakeLLMClient & FakeEmbeddings<br/>(Deterministic Offline Test Mode)"]
    end

    subgraph PROPOSED_FUTURE ["Proposed / Future Production Infrastructure"]
        REDIS_QUEUE[("Redis 7 Task Broker<br/>(Distributed Celery / ARQ Workers)")]
        S3_STORAGE[("AWS S3 Bucket<br/>(KMS Encrypted Raw Document Store)")]
        RERANK_GPU["Cross-Encoder GPU Microservice<br/>(BGE-Reranker-Large)"]
        METRICS_PROM["Prometheus / OpenTelemetry APM<br/>(Centralized Distributed Tracing)"]
    end

    %% Wiring
    CLIENT_TIER -->|"HTTPS / REST API"| API_GATEWAY
    API_GATEWAY --> CORE_SERVICES

    DOC_SVC --> CHUNK_SVC
    CHUNK_SVC --> DB_DOCS
    DOC_SVC --> LOCAL_STORAGE

    RAG_SVC --> HYBRID_SVC
    HYBRID_SVC --> DB_DOCS
    RAG_SVC --> GATE_SVC
    RAG_SVC --> LLM_ROUTER
    RAG_SVC --> VERIFY_SVC
    RAG_SVC --> MEM_SVC
    MEM_SVC --> DB_CONV
    RAG_SVC --> DB_CITATIONS

    AGENT_SVC --> AGENT_TOOLS
    T1 --> HYBRID_SVC
    T2 --> DB_DOCS
    T3 --> LLM_ROUTER
    AGENT_SVC --> DB_RUNS

    LLM_ROUTER --> CLAUDE
    LLM_ROUTER -.->|"Circuit-Breaker Failover"| OPENAI
    LLM_ROUTER -.->|"Test Benchmark Mode"| FAKE_LLM

    LLM_ROUTER --> DB_LOGS
    CORE_SERVICES --> LANGFUSE
    DB_LOGS --> DB_TELEMETRY
