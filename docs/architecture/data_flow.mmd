sequenceDiagram
    autonumber
    %% =========================================================================
    %% DATA FLOW DIAGRAM: INGESTION PIPELINE & GROUNDED RAG PIPELINE
    %% =========================================================================

    actor Engineer as Engineering User
    participant WebClient as React 18 SPA (Vite)
    participant Gateway as FastAPI Ingress (/api/v1)
    participant DocSvc as Document Service
    participant Extractor as PyMuPDF / Text Parsers
    participant Chunker as Recursive Chunker
    participant RAGSvc as RAG Orchestrator
    participant Gate as Evidence Sufficiency Gate
    participant Retrieval as Hybrid Retrieval (Dense + BM25)
    participant DB as PostgreSQL 16 (pgvector + Relational)
    participant LocalStorage as Local Storage (storage/documents/)
    participant Router as LLM Router & Circuit Breaker
    participant Verifier as Grounding Verifier
    participant Telemetry as Usage Telemetry & Langfuse

    %% -------------------------------------------------------------------------
    %% FLOW 1: DOCUMENT INGESTION & VECTOR INDEXING PIPELINE
    %% -------------------------------------------------------------------------
    rect rgb(240, 249, 255)
        Note over Engineer, LocalStorage: FLOW 1: DOCUMENT INGESTION & VECTOR INDEXING PIPELINE
        Engineer->>WebClient: Upload technical document (PDF, TXT, MD, CSV)
        WebClient->>Gateway: POST /api/v1/workspaces/{ws_id}/documents/upload (Multipart)
        Gateway->>Gateway: Validate file extension & size limit (<= 20MB)
        Gateway->>DocSvc: Process Ingestion Request
        DocSvc->>DocSvc: Compute SHA-256 Checksum
        DocSvc->>DB: Check for duplicate hash in workspace
        alt Duplicate Detected
            DB-->>DocSvc: Existing document found
            DocSvc-->>Gateway: HTTP 409 Conflict / Existing Document Info
            Gateway-->>WebClient: Duplicate document warning
        else Unique File
            DocSvc->>LocalStorage: Persist raw document file (storage/documents/{doc_id}/)
            DocSvc->>DB: Insert document record (status='PENDING')
            DocSvc-->>Gateway: Ingestion Task Accepted
            Gateway-->>WebClient: HTTP 202 Accepted (DocumentResponse, status='PENDING')
            
            Note over DocSvc, DB: Asynchronous Background Processing
            DocSvc->>DB: Update document status -> 'PROCESSING'
            DocSvc->>Extractor: Extract text and structural metadata (fitz / text)
            Extractor-->>DocSvc: Clean normalized text string
            DocSvc->>Chunker: Split into chunks (~512 tokens, 10% overlap)
            Chunker-->>DocSvc: List of text chunks with chunk_index and metadata
            DocSvc->>Router: Batch generate 1536-dim embeddings
            Router-->>DocSvc: Vector embeddings list
            DocSvc->>DB: Batch upsert into `chunks` (document_id, chunk_index, content, embedding)
            DocSvc->>DB: Update document status -> 'INDEXED' (chunk_count=N)
            WebClient->>Gateway: Poll GET /api/v1/workspaces/{ws_id}/documents/{id}
            Gateway-->>WebClient: status='INDEXED' -> UI updates to ready state
        end
    end

    %% -------------------------------------------------------------------------
    %% FLOW 2: EVIDENCE-GROUNDED RAG & INVESTIGATION QUERY PIPELINE
    %% -------------------------------------------------------------------------
    rect rgb(245, 255, 245)
        Note over Engineer, Telemetry: FLOW 2: EVIDENCE-GROUNDED RAG QUERY PIPELINE
        Engineer->>WebClient: Submit question ("What caused Incident 104?")
        WebClient->>Gateway: POST /api/v1/workspaces/{ws_id}/chat (query, conversation_id)
        Gateway->>RAGSvc: Orchestrate RAG answer generation
        RAGSvc->>DB: Retrieve prior conversation turns (sliding window)
        DB-->>RAGSvc: Prior conversation context
        RAGSvc->>Retrieval: Retrieve candidates (query, top_k=5, mode='hybrid')
        Retrieval->>DB: Dense cosine vector search (pgvector)
        Retrieval->>DB: Sparse BM25 lexical token match
        DB-->>Retrieval: Combined candidate chunks
        Retrieval->>Retrieval: Reciprocal Rank Fusion (RRF k=60)
        Retrieval-->>RAGSvc: Top ranked chunks
        
        RAGSvc->>Gate: Evaluate evidence sufficiency (query terms, chunk coverage)
        alt Insufficient Evidence (Coverage < 25%)
            Gate-->>RAGSvc: Short-circuit decision: INSUFFICIENT
            RAGSvc-->>Gateway: Abstain honestly ("I do not have sufficient evidence...")
            Gateway-->>WebClient: HTTP 200 with is_abstention=True (0 tokens used)
        else Sufficient Evidence
            Gate-->>RAGSvc: Triage: Filter distractors, detect date/numerical conflicts
            RAGSvc->>Router: Synthesize answer with untrusted XML context blocks
            Router->>Telemetry: Langfuse trace generation
            Router->>Router: Try primary provider (Claude 3.5 Sonnet)
            alt Primary API Failure (429 / 5xx)
                Router->>Router: Automatic fallback to secondary provider (GPT-4o)
            end
            Router-->>RAGSvc: Raw generated text + token counts
            Router->>DB: Log single-entry LLMUsageEvent in `llm_logs`
            
            RAGSvc->>Verifier: Verify claim grounding against cited chunks
            Verifier-->>RAGSvc: Grounding verification result + ungrounded claims
            RAGSvc->>DB: Persist user message, assistant message, and citations
            RAGSvc-->>Gateway: ChatResponse (answer, citations, latency_ms)
            Gateway-->>WebClient: HTTP 200 with grounded response & citations
            WebClient-->>Engineer: Render answer with interactive clickable citations
        end
    end
